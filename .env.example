# Couch Owl configuration
# Copy to .env and adjust. Never commit .env – it contains secrets.

# --- Required in production -----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Set to True only for local development
DEBUG=False
# The address people use to open Couch Owl, without a path. Sets the allowed host, secure
# cookies and HSTS (with https), and the links in invitation and password reset e-mails.
# Empty: only http://localhost:8000 works. Examples:
#   https://couchowl.example.com   (behind a reverse proxy with HTTPS)
#   http://192.168.1.20:8000      (home network only)
SITE_URL=
# Number of reverse proxies in front of Couch Owl (usually 1, 0 = none). Only then does
# Couch Owl believe the X-Forwarded-For/-Proto headers. Wrong values either lock out all
# users together after failed logins (too low) or let attackers fake their address
# (too high). See docs/deployment.md.
TRUSTED_PROXY_COUNT=0
# How long browsers must use https only (HSTS), in seconds. Default with an https
# SITE_URL: one year. 0 = don't send the header (e.g. if the proxy already does).
# HSTS_SECONDS=31536000

# Optional: further host names and origins besides SITE_URL (comma-separated)
# ALLOWED_HOSTS=nas.local
# CSRF_TRUSTED_ORIGINS=http://nas.local:8000

# --- Docker image (read by docker-compose.yml) --------------------------------------
# Which Couch Owl version to run: latest (newest release), 1 (all 1.x updates, no major
# upgrades), 1.2 (only bug fixes of 1.2), an exact version like 1.2.3, or next (the most
# recently published release, release candidates included).
# Get updates with: docker compose pull && docker compose up -d
# COUCHOWL_VERSION=latest

# --- Data -------------------------------------------------------------------------
# Directory for database, poster cache and backups (Docker: /data volume)
# DATA_DIR=/data
# Optional PostgreSQL instead of SQLite:
# DATABASE_URL=postgres://couchowl:password@db:5432/couchowl
# Nightly consistent copy of the SQLite database for your own backup (03:00 UTC)
# BACKUP_DIR=/data/backups
# How many copies to keep (older ones are deleted; keep versions in your own backup)
BACKUP_KEEP=3

# --- Languages and region ---------------------------------------------------------
# Fallback interface language when the browser's or region's language has no translation
DEFAULT_LANGUAGE=en
# Country for new users whose browser doesn't reveal one (empty = US). The region also
# determines the languages; users can change everything in their profile.
DEFAULT_REGION=
TIME_ZONE=Europe/Berlin

# --- TMDB ---------------------------------------------------------------------------
# "API Read Access Token" (starts with eyJ…) from https://www.themoviedb.org/settings/api
# Sent as Bearer header, never in URLs. Not the short "API Key".
# Without it, search and movie/show data are unavailable.
TMDB_API_TOKEN=

# --- Dashboard ---------------------------------------------------------------------
# Announce new seasons of followed shows that start within this many months
ANNOUNCEMENT_MONTHS=3

# --- E-mail (optional) ------------------------------------------------------------
# Without EMAIL_URL, "forgot password" is hidden; admins create reset links instead.
# EMAIL_URL=smtp+tls://user:password@mail.example.com:587
# Development: print mails to the terminal
# EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=Couch Owl <couchowl@example.com>

# --- Accounts -------------------------------------------------------------------------
# Users stay logged in until they haven't visited Couch Owl for this many days
SESSION_DAYS=90
# How long invitation links and password reset links stay valid
INVITATION_EXPIRY_DAYS=7
PASSWORD_RESET_TIMEOUT_HOURS=24
# Brute-force protection: lock username + IP after this many failed logins, for this long
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=60

# --- Legal links and source code (optional) ---------------------------------------
# Links to your legal notice ("Impressum") and privacy policy, shown in the footer and on
# the About page. Leave empty to hide them.
# IMPRINT_URL=https://example.com/legal-notice
# PRIVACY_URL=https://example.com/privacy
# Source code link on the About page. Couch Owl is licensed under the AGPL: if you run a
# changed version for others, point this to your changed source code.
# SOURCE_URL=https://github.com/okoetter/couchowl

# --- Misc ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Number of web server processes (gunicorn workers). 2 is plenty for a household;
# fewer save memory.
# WEB_WORKERS=2
