# Scheduled jobs inside the container (run by supercronic). Times are UTC.

# Consistent copy of the database to $BACKUP_DIR (default /data/backups) for the host's backup
0 3 * * * python manage.py backup

# Remove expired login sessions
15 3 * * * python manage.py clearsessions

# Reload followed and watched shows from TMDB: new seasons, air dates, streaming providers
30 3 * * * python manage.py sync_tmdb
