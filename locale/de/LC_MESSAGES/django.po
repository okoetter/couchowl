#: accounts/templates/accounts/profile.html:30
msgid "Log out"
msgstr "Abmelden"

#: accounts/templates/accounts/rate_limited.html:4
#: accounts/templates/accounts/rate_limited.html:7
msgid "Too many requests"
msgstr "Zu viele Anfragen"

#: accounts/templates/accounts/rate_limited.html:8
msgid "Please wait a while and try again later."
msgstr "Bitte warte eine Weile und versuch es später noch einmal."

#: accounts/templates/accounts/register.html:4
#: accounts/templates/accounts/register.html:7
#: accounts/templates/accounts/register.html:12
msgid "Create account"
msgstr "Konto anlegen"

#: accounts/templates/accounts/register.html:8
msgid "You have been invited to watchit. Choose a username and a password."
msgstr ""
"Du wurdest zu watchit eingeladen. Wähle einen Benutzernamen und ein Passwort."

#: accounts/views.py:30
msgid "You are already logged in."
msgstr "Du bist bereits angemeldet."

#: accounts/views.py:48
#, python-format
msgid "Welcome to watchit, %(name)s!"
msgstr "Willkommen bei watchit, %(name)s!"

#: accounts/views.py:63
msgid "Your profile has been saved."
msgstr "Dein Profil wurde gespeichert."

#: accounts/views.py:74
msgid "Your password has been changed."
msgstr "Dein Passwort wurde geändert."

