msgstr "Einladungen"

#: accounts/models.py:130
#, python-format
msgid "Invitation #%(id)s"
msgstr "Einladung #%(id)s"

#: accounts/templates/accounts/email/invitation_body.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"%(name)s has invited you to watchit, a watchlist for movies and TV shows.\n"
"Create your account with this link:"
msgstr ""
"Hallo,\n"
"\n"
"%(name)s hat dich zu watchit eingeladen, einer Watchlist für Filme und "
"Serien.\n"
"Lege dein Konto über diesen Link an:"

#: accounts/templates/accounts/email/invitation_body.txt:8
#, python-format
msgid "The link is valid until %(date)s and can only be used once."
msgstr "Der Link ist bis %(date)s gültig und kann nur einmal benutzt werden."

#: accounts/templates/accounts/email/invitation_subject.txt:1
msgid "Your invitation to watchit"
msgstr "Deine Einladung zu watchit"

#: accounts/templates/accounts/email/password_reset_body.txt:1
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"someone (hopefully you) asked to reset your watchit password. Set a new "
"password with this link:"
msgstr ""
"Hallo %(name)s,\n"
"\n"
"jemand (hoffentlich du) möchte dein watchit-Passwort zurücksetzen. Über "
"diesen Link legst du ein neues Passwort fest:"

#: accounts/templates/accounts/email/password_reset_body.txt:7
msgid "If you did not request this, you can ignore this e-mail."
msgstr ""
"Falls du das nicht angefordert hast, kannst du diese E-Mail ignorieren."

#: accounts/templates/accounts/email/password_reset_subject.txt:1
msgid "Reset your watchit password"
msgstr "Dein watchit-Passwort zurücksetzen"

#: accounts/templates/accounts/invitation_invalid.html:4
#: accounts/templates/accounts/invitation_invalid.html:7
msgid "Invalid invitation"
msgstr "Ungültige Einladung"

#: accounts/templates/accounts/invitation_invalid.html:8
msgid ""
"This invitation link has expired or has already been used. Please ask your "
"administrator for a new one."
msgstr ""
"Dieser Einladungslink ist abgelaufen oder wurde bereits benutzt. Bitte frag "
"deinen Administrator nach einem neuen."

#: accounts/templates/accounts/invitation_invalid.html:9
#: accounts/templates/accounts/password_reset_confirm.html:16
msgid "Go to login"
msgstr "Zur Anmeldung"

#: accounts/templates/accounts/locked_out.html:4
#: accounts/templates/accounts/locked_out.html:7
msgid "Login locked"
msgstr "Anmeldung gesperrt"

#: accounts/templates/accounts/locked_out.html:8
msgid "Too many failed login attempts. Please try again later."
msgstr ""
"Zu viele fehlgeschlagene Anmeldeversuche. Bitte versuch es später noch "
"einmal."

#: accounts/templates/accounts/locked_out.html:9
msgid "If you cannot wait, your administrator can unlock your account."
msgstr ""
"Wenn du nicht warten kannst, kann dein Administrator die Sperre aufheben."

#: accounts/templates/accounts/locked_out.html:10
#: accounts/templates/accounts/password_reset_done.html:10
#: accounts/templates/accounts/password_reset_form.html:14
msgid "Back to login"
msgstr "Zurück zur Anmeldung"

#: accounts/templates/accounts/login.html:4
#: accounts/templates/accounts/login.html:7
#: accounts/templates/accounts/login.html:12
#: accounts/templates/accounts/password_reset_complete.html:9
msgid "Log in"
msgstr "Anmelden"

#: accounts/templates/accounts/login.html:16
#: accounts/templates/accounts/password_reset_form.html:4
#: accounts/templates/accounts/password_reset_form.html:7
msgid "Forgot your password?"
msgstr "Passwort vergessen?"

#: accounts/templates/accounts/login.html:18
msgid "Forgot your password? Please contact your administrator."
msgstr "Passwort vergessen? Bitte wende dich an deinen Administrator."

#: accounts/templates/accounts/login.html:20
msgid "watchit is invite-only. Ask your administrator for an invitation link."
msgstr ""
"watchit funktioniert nur mit Einladung. Frag deinen Administrator nach einem "
"Einladungslink."

#: accounts/templates/accounts/password_change.html:4
#: accounts/templates/accounts/password_change.html:7
#: accounts/templates/accounts/password_change.html:11
#: accounts/templates/accounts/profile.html:27
msgid "Change password"
msgstr "Passwort ändern"

#: accounts/templates/accounts/password_change.html:13
msgid "Back to profile"
msgstr "Zurück zum Profil"

#: accounts/templates/accounts/password_reset_complete.html:4
#: accounts/templates/accounts/password_reset_complete.html:7
msgid "Password set"
msgstr "Passwort festgelegt"

#: accounts/templates/accounts/password_reset_complete.html:8
msgid "Your new password has been set. You can log in now."
msgstr "Dein neues Passwort ist festgelegt. Du kannst dich jetzt anmelden."

#: accounts/templates/accounts/password_reset_confirm.html:4
#: accounts/templates/accounts/password_reset_confirm.html:7
msgid "Set a new password"
msgstr "Neues Passwort festlegen"

#: accounts/templates/accounts/password_reset_confirm.html:12
msgid "Set password"
msgstr "Passwort festlegen"

#: accounts/templates/accounts/password_reset_confirm.html:15
msgid "This link is invalid or has expired. Please request a new one."
msgstr ""
"Dieser Link ist ungültig oder abgelaufen. Bitte fordere einen neuen an."

#: accounts/templates/accounts/password_reset_done.html:4
#: accounts/templates/accounts/password_reset_done.html:7
msgid "Check your e-mail"
msgstr "Schau in dein E-Mail-Postfach"

#: accounts/templates/accounts/password_reset_done.html:9
msgid ""
"If an account with this e-mail address exists, we have sent you a link to "
"set a new password. Please also check your spam folder."
msgstr ""
"Falls ein Konto mit dieser E-Mail-Adresse existiert, haben wir dir einen "
"Link zum Festlegen eines neuen Passworts geschickt. Schau bitte auch im Spam-"
"Ordner nach."

#: accounts/templates/accounts/password_reset_form.html:8
msgid ""
"Enter the e-mail address of your account. We will send you a link to set a "
"new password."
msgstr ""
"Gib die E-Mail-Adresse deines Kontos ein. Wir schicken dir einen Link, mit "
"dem du ein neues Passwort festlegen kannst."

#: accounts/templates/accounts/password_reset_form.html:12
msgid "Send link"
msgstr "Link senden"

#: accounts/templates/accounts/profile.html:4
#: accounts/templates/accounts/profile.html:7 core/templates/core/_nav.html:37
msgid "Profile"
msgstr "Profil"

#: accounts/templates/accounts/profile.html:8
#, python-format
msgid "Logged in as <strong>%(name)s</strong>."
msgstr "Angemeldet als <strong>%(name)s</strong>."

