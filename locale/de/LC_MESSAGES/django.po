msgstr "Sprache der Oberfläche"

#: accounts/models.py:28
msgid "language for movie and show information"
msgstr "Sprache für Film- und Serieninfos"

#: accounts/models.py:31
msgid "TMDB language code, e.g. de-DE or en-US."
msgstr "TMDB-Sprachcode, z. B. de-DE oder en-US."

#: accounts/models.py:34
msgid "region"
msgstr "Region"

#: accounts/models.py:38
msgid ""
"Country for streaming providers and release dates, e.g. DE. Empty: derived "
"from the language for movie and show information."
msgstr ""
"Land für Streaming-Anbieter und Veröffentlichungstermine, z. B. DE. Leer: "
"wird aus der Sprache für Film- und Serieninfos abgeleitet."

#: accounts/models.py:43
msgid "color scheme"
msgstr "Farbschema"

