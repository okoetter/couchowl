msgid "Invalid invitation"
msgstr "Ungültige Einladung"

#: accounts/templates/accounts/invitation_invalid.html:8
msgid ""
"This invitation link has expired or has already been used. Please ask your "
"administrator for a new one."
msgstr ""
"Dieser Einladungslink ist abgelaufen oder wurde bereits benutzt. Bitte frag "
"deinen Administrator nach einem neuen."

