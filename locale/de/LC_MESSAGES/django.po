#: accounts/admin.py:89
msgid "Invitation created. Copy the link below."
msgstr "Einladung erstellt. Kopiere den Link unten."

#: accounts/admin.py:92
msgid "Send invitation by e-mail"
msgstr "Einladung per E-Mail senden"

#: accounts/admin.py:96
msgid "Sending e-mail is not configured (EMAIL_URL)."
msgstr "Der E-Mail-Versand ist nicht eingerichtet (EMAIL_URL)."

