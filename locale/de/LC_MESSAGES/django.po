msgstr "Diese Seite kommt bald."

#: core/views.py:46
msgid "Your watchlist for movies and TV shows"
msgstr "Deine Watchlist für Filme und Serien"

#: templates/admin/accounts/invitation/change_form.html:8
msgid "Invitation link"
msgstr "Einladungslink"

#: templates/admin/accounts/invitation/change_form.html:10
