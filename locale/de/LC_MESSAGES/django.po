msgstr ""
"Du wurdest zu Couch Owl eingeladen. Wähle einen Benutzernamen und ein "
"Passwort."

#: accounts/templates/accounts/reset_data.html:4
#: accounts/templates/accounts/reset_data.html:7
msgid "Reset my data"
msgstr "Meine Daten zurücksetzen"

#: accounts/templates/accounts/reset_data.html:9
msgid ""
"You have no lists, watched movies or episodes and follow no shows. There is "
"nothing to delete."
msgstr ""
"Du hast keine Listen, keine gesehenen Filme oder Folgen und folgst keinen "
"Serien. Es gibt nichts zu löschen."

#: accounts/templates/accounts/reset_data.html:12
msgid "This deletes:"
msgstr "Gelöscht werden:"

#: accounts/templates/accounts/reset_data.html:14
#, python-format
msgid "%(counter)s list with all its titles"
msgid_plural "%(counter)s lists with all their titles"
msgstr[0] "%(counter)s Liste mit allen ihren Titeln"
msgstr[1] "%(counter)s Listen mit allen ihren Titeln"

#: accounts/templates/accounts/reset_data.html:15
#, python-format
msgid "%(counter)s watched movie"
msgid_plural "%(counter)s watched movies"
msgstr[0] "%(counter)s gesehener Film"
msgstr[1] "%(counter)s gesehene Filme"

#: accounts/templates/accounts/reset_data.html:16
#, python-format
msgid "%(counter)s watched episode"
msgid_plural "%(counter)s watched episodes"
msgstr[0] "%(counter)s gesehene Folge"
msgstr[1] "%(counter)s gesehene Folgen"

#: accounts/templates/accounts/reset_data.html:17
#, python-format
msgid "%(counter)s followed show"
msgid_plural "%(counter)s followed shows"
msgstr[0] "%(counter)s gefolgte Serie"
msgstr[1] "%(counter)s gefolgte Serien"

#: accounts/templates/accounts/reset_data.html:19
msgid "Your account, password and profile settings stay."
msgstr "Dein Konto, dein Passwort und deine Profileinstellungen bleiben."

#: accounts/templates/accounts/reset_data.html:21
msgid "This can't be undone."
msgstr "Das kann nicht rückgängig gemacht werden."

#: accounts/templates/accounts/reset_data.html:22
msgid ""
"Not even your administrator can restore your data alone: backups always "
"contain all users."
msgstr ""
"Auch dein Administrator kann nicht nur deine Daten wiederherstellen: Backups "
"enthalten immer alle Benutzer."

