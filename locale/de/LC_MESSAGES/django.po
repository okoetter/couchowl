#, python-format
msgid "%(invitation)s is used or expired and was skipped."
msgstr "%(invitation)s ist benutzt oder abgelaufen und wurde übersprungen."

#: accounts/admin.py:110
#, python-format
msgid "%(invitation)s has no e-mail address and was skipped."
msgstr "%(invitation)s hat keine E-Mail-Adresse und wurde übersprungen."

#: accounts/admin.py:123
#, python-format
msgid "Could not send e-mail to %(email)s: %(error)s"
msgstr "E-Mail an %(email)s konnte nicht gesendet werden: %(error)s"

#: accounts/admin.py:130
#, python-format
msgid "Invitation sent to %(email)s."
msgstr "Einladung an %(email)s gesendet."

#: accounts/forms.py:37
msgid "This e-mail address is already used by another account."
msgstr "Diese E-Mail-Adresse wird bereits von einem anderen Konto verwendet."

#: accounts/forms.py:47
msgid "Username or password is incorrect. Note that both are case-sensitive."
msgstr ""
"Benutzername oder Passwort ist falsch. Achte auf Groß- und Kleinschreibung."

#: accounts/forms.py:59 accounts/forms.py:71
msgid "Optional. Needed if you want to reset a forgotten password yourself."
msgstr ""
"Optional. Nötig, wenn du ein vergessenes Passwort selbst zurücksetzen "
"möchtest."

#: accounts/forms.py:73
msgid ""
"Two-letter country code (e.g. AT) for streaming providers and release dates. "
"Leave empty to derive it from the language for movie and show information."
msgstr ""
"Zweistelliger Ländercode (z. B. AT) für Streaming-Anbieter und "
"Veröffentlichungstermine. Leer lassen, um ihn aus der Sprache für Film- und "
"Serieninfos abzuleiten."

#: accounts/forms.py:82 accounts/forms.py:95
#, python-format
msgid "Server default (%(language)s)"
msgstr "Serverstandard (%(language)s)"

#: accounts/forms.py:108
msgid "Enter a valid two-letter country code such as DE or AT."
msgstr "Gib einen gültigen zweistelligen Ländercode wie DE oder AT ein."

#: accounts/models.py:16
msgid "Automatic (system)"
msgstr "Automatisch (System)"

#: accounts/models.py:17
msgid "Light"
msgstr "Hell"

#: accounts/models.py:18
msgid "Dark"
msgstr "Dunkel"

#: accounts/models.py:22
