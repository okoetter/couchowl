msgstr "Nur für Admins sichtbar."

#: accounts/models.py:102
msgid "created by"
msgstr "erstellt von"

#: accounts/models.py:109
msgid "created at"
msgstr "erstellt am"

#: accounts/models.py:110
msgid "expires at"
msgstr "gültig bis"

#: accounts/models.py:113
msgid "used by"
msgstr "benutzt von"

#: accounts/models.py:120
msgid "used at"
msgstr "benutzt am"

